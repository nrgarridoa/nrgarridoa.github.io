rules_version = '2';

// Reglas de Firestore para el aula virtual.
// Se pegan en: Firebase Console -> Firestore Database -> Reglas -> Publicar.
// El correo del administrador (ADMIN) debe coincidir con assets/js/aula/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && me() == 'ngarridoa18_1@unc.edu.pe';
    }
    function enrollment() {
      return get(/databases/$(database)/documents/enrollments/$(me())).data;
    }
    function enrolled(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/enrollments/$(me()))
        && enrollment().active == true
        && courseId in enrollment().courses;
    }

    // Alumnos autorizados: un documento por correo (en minúsculas).
    match /enrollments/{email} {
      allow read: if isAdmin() || (signedIn() && email == me());
      allow write: if isAdmin();
    }

    // Contenido privado de cada curso (videos y materiales por sesión).
    match /courses/{courseId} {
      allow read: if isAdmin() || enrolled(courseId);
      allow write: if isAdmin();
    }

    // Certificados: el alumno los solicita (pendiente) y solo el admin los emite.
    // Cualquiera puede consultar un certificado emitido si conoce su código.
    match /certificates/{code} {
      allow get: if resource == null
        || resource.data.status == 'issued'
        || isAdmin()
        || (signedIn() && resource.data.ownerEmail == me());
      allow list: if isAdmin() || (signedIn() && resource.data.ownerEmail == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerEmail', 'name', 'courseId', 'courseTitle', 'hours', 'status', 'requestedAt'])
        && request.resource.data.ownerEmail == me()
        && request.resource.data.status == 'pending'
        && enrolled(request.resource.data.courseId);
      allow update, delete: if isAdmin();
    }

    // Postulaciones: las envía cada persona con su cuenta de Google (una por curso).
    match /applications/{id} {
      allow get: if isAdmin()
        || (signedIn() && (resource == null || resource.data.ownerEmail == me()));
      allow list: if isAdmin() || (signedIn() && resource.data.ownerEmail == me());
      allow create: if signedIn()
        && id == me() + '__' + request.resource.data.courseId
        && request.resource.data.keys().hasOnly(['ownerEmail', 'name', 'courseId', 'courseTitle', 'linkedin', 'profile', 'goal', 'status', 'createdAt'])
        && request.resource.data.ownerEmail == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
        && request.resource.data.linkedin.size() <= 200
        && request.resource.data.linkedin.matches('^https://([a-z0-9-]+\\.)?linkedin\\.com/(in|pub)/.+')
        && request.resource.data.profile.size() > 1 && request.resource.data.profile.size() <= 1000
        && request.resource.data.goal.size() > 1 && request.resource.data.goal.size() <= 1000;
      allow update, delete: if isAdmin();
    }

    // Progreso y notas de cada alumno por curso.
    match /users/{email}/progress/{courseId} {
      allow read, write: if isAdmin() || (signedIn() && email == me() && enrolled(courseId));
    }
  }
}
