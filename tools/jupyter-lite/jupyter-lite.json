{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "Aula virtual - Jupyter",
    "contentsStorageName": "AulaJupyter",
    "settingsStorageName": "AulaJupyter",
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "pyodideUrl": "https://cdn.jsdelivr.net/pyodide/v0.29.5/full/pyodide.mjs",
        "loadPyodideOptions": {
          "packages": [
            "numpy",
            "pandas",
            "matplotlib",
            "scipy"
          ]
        }
      }
    }
  }
}